{
  "entities": {
    "Roadmap": {
      "title": "Roadmap",
      "description": "A generated strategic roadmap for a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string", "description": "The user ID who owns this roadmap." },
        "projectName": { "type": "string" },
        "summary": { "type": "string" },
        "startingPoint": { "type": "string" },
        "kickstartChecklist": { "type": "array", "items": { "type": "string" } },
        "mvpFeatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "phases": { "type": "array", "items": { "$ref": "RoadmapPhase" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "totalBudget": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["uid", "projectName", "summary", "startingPoint", "kickstartChecklist", "mvpFeatures", "phases", "createdAt", "totalBudget", "currency"]
    },
    "RoadmapPhase": {
      "title": "Roadmap Phase",
      "description": "A specific phase within a roadmap.",
      "type": "object",
      "properties": {
        "phase": { "type": "string" },
        "title": { "type": "string" },
        "goals": { "type": "array", "items": { "type": "string" } },
        "tasks": { "type": "array", "items": { "$ref": "Task" } },
        "features": { "type": "array", "items": { "type": "string" } },
        "pmRationale": { "type": "string" },
        "risks": { "type": "array", "items": { "$ref": "Risk" } },
        "budget": { "type": "number" }
      },
      "required": ["phase", "title", "goals", "tasks", "features", "pmRationale", "risks", "budget"]
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "deadline": { "type": "string" },
        "status": { "type": "string", "enum": ["todo", "in-progress", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "estimation": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string" }
          },
          "required": ["value", "unit"]
        },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "startDate": { "type": "string" },
        "duration": { "type": "number" },
        "cost": { "type": "number" }
      },
      "required": ["id", "description", "owner", "deadline", "status", "priority", "estimation", "dependencies", "startDate", "duration", "cost"]
    },
    "Risk": {
      "title": "Risk",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "mitigation": { "type": "string" },
        "category": { "type": "string" },
        "impact": { "type": "string" },
        "probability": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/roadmaps/{roadmapId}": {
      "schema": "Roadmap",
      "description": "Collection of roadmaps generated by users."
    }
  }
}
